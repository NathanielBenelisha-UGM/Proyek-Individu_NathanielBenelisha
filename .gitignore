# ===== Temporary & OS Files =====
~$*
*.tmp
*.temp
.DS_Store
Thumbs.db
desktop.ini

# ===== Large Binary Archives =====
# Exclude large archives (CPLEX installer, zip backups)
*.rar
*.zip
Coding/cplex-22.1.1/

# ===== Python Cache =====
__pycache__/
*.pyc
.ipynb_checkpoints/

# ===== Jupyter Temp Notebooks =====
# Temporary scenario notebooks (auto-generated by run_all_scenarios.py)
Coding/_temp_scenario_*.ipynb

# ===== VS Code =====
*.code-workspace
.vscode/

# ===== LaTeX Build Artifacts =====
Paper/*.aux
Paper/*.log
Paper/*.out
Paper/*.bbl
Paper/*.blg
Paper/*.synctex*
Paper/*.fdb_latexmk
Paper/*.fls
